<Window x:Class="Iseller.Pos.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="iSeller POS" Height="820" Width="1400"
        MinHeight="640" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource PosWindow}"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="32" />
        </Grid.RowDefinitions>

        <!-- Cabecera -->
        <Border Grid.Row="0" Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="Assets/logo1-inv-compact-128.png" Width="30" Height="30"
                           Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="iSELLER" FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource MintBrush}" />
                    <TextBlock Text="POS" FontSize="16" FontWeight="Bold" Margin="6,0,0,0" />
                    <TextBlock x:Name="TextoSucursal" Style="{StaticResource MutedText}"
                               Margin="24,0,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Ellipse x:Name="PuntoConexion" Width="8" Height="8"
                             Fill="{StaticResource WarningBrush}" Margin="0,0,8,0" />
                    <TextBlock x:Name="TextoEstadoConexion" Text="Comprobando…"
                               Style="{StaticResource MutedText}" VerticalAlignment="Center"
                               Margin="0,0,16,0" />
                    <Button Content="AJUSTES" Style="{StaticResource SecondaryButton}" Padding="12,6"
                            Click="Ajustes_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Aviso de tasa vieja -->
        <Border Grid.Row="1" x:Name="AvisoTasas" Visibility="Collapsed"
                Background="{StaticResource DangerDimBrush}" BorderBrush="{StaticResource DangerBrush}"
                BorderThickness="0,0,0,1" Padding="20,8">
            <TextBlock x:Name="TextoAvisoTasas" Foreground="{StaticResource DangerBrush}" />
        </Border>

        <!-- Venta / pendientes -->
        <TabControl Grid.Row="2" Margin="20,16,20,12">
            <TabItem Header="Venta">
                <Grid Margin="0,16,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                        <Button Content="SINCRONIZAR CATÁLOGO" Style="{StaticResource PrimaryButton}"
                                Click="Sincronizar_Click" />
                        <Button Content="ENVIAR PENDIENTES" Style="{StaticResource SecondaryButton}"
                                Margin="10,0,0,0" Click="Enviar_Click" />
                        <Button Content="VERIFICAR CONEXIÓN" Style="{StaticResource SecondaryButton}"
                                Margin="10,0,0,0" Click="Verificar_Click" />
                    </StackPanel>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="5*" />
                            <ColumnDefinition Width="6*" />
                        </Grid.ColumnDefinitions>

                        <!-- Buscador -->
                    <Grid Grid.Column="0" Margin="0,0,16,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel>
                            <TextBlock Text="Buscar producto o escanear código (Enter agrega)"
                                       Style="{StaticResource MutedText}" Margin="2,0,0,6" />
                            <TextBox x:Name="CampoBusqueda" Padding="12,10" FontSize="15"
                                     TextChanged="CampoBusqueda_TextChanged"
                                     KeyDown="CampoBusqueda_KeyDown" />
                        </StackPanel>

                        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0" Margin="0,12,0,0">
                            <DataGrid x:Name="TablaResultados" AutoGenerateColumns="False"
                                      IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                      RowHeight="34" MouseDoubleClick="TablaResultados_MouseDoubleClick">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="PRODUCTO" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Nombre}" TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Nombre}" VerticalAlignment="Center" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="STOCK" Binding="{Binding Stock}" Width="62" />
                                    <DataGridTextColumn Header="DÓLARES" Binding="{Binding PrecioDolar}" Width="82" />
                                    <DataGridTextColumn Header="BOLÍVARES" Binding="{Binding PrecioBs}" Width="106" />
                                    <DataGridTextColumn Header="PESOS" Binding="{Binding PrecioPeso}" Width="106" />
                                    <DataGridTemplateColumn Header="" Width="92">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="AGREGAR" Style="{StaticResource PrimaryButton}"
                                                        Padding="8,4" FontSize="10" Click="Agregar_Click" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </Grid>

                    <!-- Carrito -->
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="0">
                            <Grid>
                                <DataGrid x:Name="TablaCarrito" AutoGenerateColumns="False" IsReadOnly="True"
                                          BorderThickness="0" Background="Transparent" RowHeight="40">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="CANT." Binding="{Binding Cantidad}" Width="60" />
                                        <DataGridTemplateColumn Header="PRODUCTO" Width="*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Nombre}" TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding Nombre}" VerticalAlignment="Center" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="PESO" Binding="{Binding Peso}" Width="118" />
                                        <DataGridTextColumn Header="BS" Binding="{Binding Bolivares}" Width="130" />
                                        <DataGridTextColumn Header="DÓLARES" Binding="{Binding Dolares}" Width="100" />
                                        <DataGridTemplateColumn Header="ACCIONES" Width="185">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Button Content="+" Style="{StaticResource MiniOutlineSuccess}"
                                                                Click="Sumar_Click" />
                                                        <Button Content="−" Style="{StaticResource MiniOutlineMuted}"
                                                                Margin="5,0,0,0" Click="Restar_Click" />
                                                        <Button Content="Quitar" Style="{StaticResource MiniOutlineDanger}"
                                                                Margin="5,0,0,0" Click="Quitar_Click" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <StackPanel x:Name="CarritoVacio" VerticalAlignment="Center"
                                            HorizontalAlignment="Center">
                                    <TextBlock Text="Aún no hay productos en el carrito" FontSize="16"
                                               FontWeight="SemiBold" HorizontalAlignment="Center" />
                                    <TextBlock Text="Agrega (B) productos para comenzar"
                                               Style="{StaticResource MutedText}" Margin="0,8,0,0"
                                               HorizontalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <TextBlock Grid.Row="1" x:Name="TextoTotales" FontSize="16" FontWeight="Bold"
                                   Margin="4,12,0,0" Text="Carrito vacío" />

                        <WrapPanel Grid.Row="2" Margin="0,14,0,0">
                            <Button x:Name="BotonCredito" Content="CRÉDITO"
                                    Style="{StaticResource SecondaryButton}" Padding="16,10"
                                    Margin="0,0,10,10" Visibility="Collapsed" Click="Credito_Click" />
                            <Button x:Name="BotonDescuento" Content="DESCONTAR PRODUCTOS"
                                    Style="{StaticResource SecondaryButton}" Padding="16,10"
                                    Margin="0,0,10,10" Visibility="Collapsed" Click="Descuento_Click" />
                            <Button Content="(C) CALCULAR CAMBIO" Style="{StaticResource SecondaryButton}"
                                    Padding="16,10" Margin="0,0,10,10" Click="Cambio_Click" />
                            <Button Content="(V) VENDER" Style="{StaticResource PrimaryButton}"
                                    Padding="20,10" Margin="0,0,10,10" Click="Vender_Click" />
                            <Button Content="DESTRUIR CARRITO" Style="{StaticResource DangerButton}"
                                    Padding="16,10" Margin="0,0,10,10" Click="Destruir_Click" />
                        </WrapPanel>
                    </Grid>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <TextBlock x:Name="HeaderPendientes" Text="No guardados" />
                </TabItem.Header>
                <Grid Margin="0,16,0,0">
                    <Border Style="{StaticResource Card}" Padding="0">
                        <DataGrid x:Name="TablaPendientes" AutoGenerateColumns="False" IsReadOnly="True"
                                  BorderThickness="0" Background="Transparent" RowHeight="34">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="FECHA" Binding="{Binding Fecha}" Width="110" />
                                <DataGridTextColumn Header="TIPO" Binding="{Binding Tipo}" Width="90" />
                                <DataGridTextColumn Header="MÉTODO" Binding="{Binding Metodo}" Width="120" />
                                <DataGridTextColumn Header="PESOS" Binding="{Binding Pesos}" Width="112" />
                                <DataGridTextColumn Header="BOLÍVARES" Binding="{Binding Bolivares}" Width="132" />
                                <DataGridTextColumn Header="DÓLARES" Binding="{Binding Dolares}" Width="100" />
                                <DataGridTextColumn Header="ESTADO" Binding="{Binding Estado}" Width="110" />
                                <DataGridTextColumn Header="DETALLE" Binding="{Binding Detalle}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Barra de estado -->
        <Border Grid.Row="3" Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="20,0">
                <TextBlock x:Name="TextoEstado" Style="{StaticResource MutedText}"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="TextoCatalogo" Style="{StaticResource MutedText}"
                           HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>

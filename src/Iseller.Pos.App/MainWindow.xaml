<Window x:Class="Iseller.Pos.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="iSeller POS" Height="800" Width="1280"
        MinHeight="600" MinWidth="1024"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource PosWindow}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="32" />
        </Grid.RowDefinitions>

        <!-- Cabecera -->
        <Border Grid.Row="0" Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="iSELLER" FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource MintBrush}" />
                    <TextBlock Text="POS" FontSize="16" FontWeight="Bold" Margin="6,0,0,0" />
                    <TextBlock x:Name="TextoSucursal" Style="{StaticResource MutedText}"
                               Margin="24,0,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Ellipse x:Name="PuntoConexion" Width="8" Height="8"
                             Fill="{StaticResource WarningBrush}" Margin="0,0,8,0" />
                    <TextBlock x:Name="TextoEstadoConexion" Text="Comprobando…"
                               Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Aviso de tasa vieja -->
        <Border Grid.Row="1" x:Name="AvisoTasas" Visibility="Collapsed"
                Background="{StaticResource DangerDimBrush}" BorderBrush="{StaticResource DangerBrush}"
                BorderThickness="0,0,0,1" Padding="20,8">
            <TextBlock x:Name="TextoAvisoTasas" Foreground="{StaticResource DangerBrush}" />
        </Border>

        <!-- Catálogo -->
        <Grid Grid.Row="2" Margin="24,20,24,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
                <TextBox x:Name="CampoBusqueda" Width="420" Padding="12,9" FontSize="15"
                         TextChanged="CampoBusqueda_TextChanged"
                         KeyDown="CampoBusqueda_KeyDown" />
                <Button Content="SINCRONIZAR CATÁLOGO" Style="{StaticResource PrimaryButton}"
                        Margin="10,0,0,0" Click="Sincronizar_Click" />
                <Button Content="VERIFICAR CONEXIÓN" Style="{StaticResource SecondaryButton}"
                        Margin="10,0,0,0" Click="Verificar_Click" />
            </StackPanel>

            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <DataGrid x:Name="TablaProductos" AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" CanUserAddRows="False" BorderThickness="0"
                              Background="Transparent" RowHeight="34">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Producto" Binding="{Binding Nombre}" Width="*" />
                            <DataGridTextColumn Header="Stock" Binding="{Binding Stock}" Width="90" />
                            <DataGridTextColumn Header="Dólares" Binding="{Binding PrecioDolar}" Width="120" />
                            <DataGridTextColumn Header="Bolívares" Binding="{Binding PrecioBs}" Width="140" />
                            <DataGridTextColumn Header="Pesos" Binding="{Binding PrecioPeso}" Width="140" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel x:Name="MensajeVacio" VerticalAlignment="Center"
                                HorizontalAlignment="Center">
                        <TextBlock Text="Sincroniza el catálogo para empezar" FontSize="16"
                                   FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Text="Necesitas conexión al menos una vez para descargar productos y tasas."
                                   Style="{StaticResource MutedText}" Margin="0,8,0,0"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Barra de estado -->
        <Border Grid.Row="3" Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="20,0">
                <TextBlock x:Name="TextoEstado" Style="{StaticResource MutedText}"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="TextoCatalogo" Style="{StaticResource MutedText}"
                           HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>

<Window x:Class="Iseller.Pos.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:Iseller.Pos.App"
        Title="iSeller POS" Height="820" Width="1400"
        MinHeight="640" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Icon="Assets/logo1-inv-compact-128.png"
        Style="{StaticResource PosWindow}"
        PreviewKeyDown="Window_PreviewKeyDown"
        StateChanged="Window_StateChanged">

    <!-- Mantiene el redimensionado nativo aunque la barra del sistema esté oculta. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Colores por moneda, iguales al POS web, y valores centrados en su columna. -->
        <Style x:Key="CeldaCantidad" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="CeldaCop" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource InfoBrush}" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="CeldaBs" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="CeldaUsd" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MintBrush}" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="32" />
        </Grid.RowDefinitions>

        <!-- Cabecera (hace de barra de título): crece si los botones se pasan de ancho. -->
        <Border Grid.Row="0" Background="{StaticResource BgBrush}" MinHeight="56"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="Barra_MouseLeftButtonDown">
            <Grid Margin="20,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"
                            ClipToBounds="True">
                    <Image Source="Assets/logo1-inv-compact-128.png" Width="30" Height="30"
                           Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="iSELLER" FontSize="16" FontWeight="Bold" Margin="0,2,0,0"
                               VerticalAlignment="Center" Foreground="{StaticResource MintBrush}" />
                    <TextBlock Text="POS" FontSize="16" FontWeight="Bold" Margin="6,2,0,0"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="TextoSucursal" Style="{StaticResource MutedText}"
                               Margin="24,0,0,0" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <WrapPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"
                           VerticalAlignment="Center">
                    <Ellipse x:Name="PuntoConexion" Width="8" Height="8"
                             Fill="{StaticResource WarningBrush}" Margin="14,0,10,0"
                             VerticalAlignment="Center" ToolTip="Comprobando…" />
                    <Button Style="{StaticResource SecondaryButton}" FontSize="11" Padding="10,5"
                            Margin="0,3,0,3" Click="UltimasVentas_Click"
                            AutomationProperties.Name="Últimas ventas"
                            ToolTip="Ver tus últimas 5 ventas y deshacerlas">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M4,6 L20,6 M4,12 L20,12 M4,18 L13,18"
                                  Stroke="{StaticResource TextBrush}" StrokeThickness="2.4"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Stretch="Uniform" Width="14" Height="14"
                                  VerticalAlignment="Center" Margin="0,0,7,0" />
                            <TextBlock Text="ÚLTIMAS VENTAS" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnMenu" Style="{StaticResource WindowButton}" Margin="10,3,0,3"
                            Click="Menu_Click" ToolTip="Herramientas"
                            AutomationProperties.Name="Herramientas">
                        <Path Data="M0,0 L14,0 M0,5 L14,5 M0,10 L14,10" Stroke="White"
                              StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Consulta de precios" Click="ConsultaPrecios_Click" />
                                <Separator />
                                <MenuItem Header="Sincronizar catálogo" Click="Sincronizar_Click" />
                                <MenuItem Header="Enviar pendientes" Click="Enviar_Click" />
                                <MenuItem Header="Verificar conexión" Click="Verificar_Click" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button x:Name="BtnAjustes" Style="{StaticResource WindowButton}" Margin="4,3,0,3"
                            Click="Ajustes_Click" ToolTip="Ajustes"
                            AutomationProperties.Name="Ajustes">
                        <Path Fill="White" Stretch="Uniform" Width="16" Height="16"
                              Data="M19.14,12.94c0.04-0.3,0.06-0.61,0.06-0.94c0-0.32-0.02-0.64-0.07-0.94l2.03-1.58c0.18-0.14,0.23-0.41,0.12-0.61l-1.92-3.32c-0.12-0.22-0.37-0.29-0.59-0.22l-2.39,0.96c-0.5-0.38-1.03-0.7-1.62-0.94L14.4,2.81c-0.04-0.24-0.24-0.41-0.48-0.41h-3.84c-0.24,0-0.43,0.17-0.47,0.41L9.25,5.35C8.66,5.59,8.12,5.92,7.63,6.29L5.24,5.33c-0.22-0.08-0.47,0-0.59,0.22L2.74,8.87C2.62,9.08,2.66,9.34,2.86,9.48l2.03,1.58C4.84,11.36,4.8,11.69,4.8,12s0.02,0.64,0.07,0.94l-2.03,1.58c-0.18,0.14-0.23,0.41-0.12,0.61l1.92,3.32c0.12,0.22,0.37,0.29,0.59,0.22l2.39-0.96c0.5,0.38,1.03,0.7,1.62,0.94l0.36,2.54c0.05,0.24,0.24,0.41,0.48,0.41h3.84c0.24,0,0.44-0.17,0.47-0.41l0.36-2.54c0.59-0.24,1.13-0.56,1.62-0.94l2.39,0.96c0.22,0.08,0.47,0,0.59-0.22l1.92-3.32c0.12-0.22,0.07-0.47-0.12-0.61L19.14,12.94z M12,15.6c-1.98,0-3.6-1.62-3.6-3.6s1.62-3.6,3.6-3.6s3.6,1.62,3.6,3.6S13.98,15.6,12,15.6z" />
                    </Button>
                    <Button x:Name="BtnMinimizar" Style="{StaticResource WindowButton}" Margin="10,3,0,3"
                            ToolTip="Minimizar" Click="Minimizar_Click">
                        <Path Data="M0,0 L11,0" Stroke="White" StrokeThickness="1.2" />
                    </Button>
                    <Button x:Name="BtnMaximizar" Style="{StaticResource WindowButton}" Margin="2,3,0,3"
                            ToolTip="Maximizar" Click="Maximizar_Click"
                            AutomationProperties.Name="Maximizar">
                        <Path x:Name="IconoMaximizar" Data="M0,0 L10,0 L10,10 L0,10 Z"
                              Stroke="White" StrokeThickness="1.2" Stretch="Uniform"
                              Width="11" Height="11" />
                    </Button>
                    <Button x:Name="BtnCerrar" Style="{StaticResource WindowCloseButton}" Margin="2,3,0,3"
                            ToolTip="Cerrar" Click="Cerrar_Click">
                        <Path Data="M0,0 L11,11 M11,0 L0,11" Stroke="White" StrokeThickness="1.2" />
                    </Button>
                </WrapPanel>
            </Grid>
        </Border>

        <!-- Aviso de tasa vieja -->
        <Border Grid.Row="1" x:Name="AvisoTasas" Visibility="Collapsed"
                Background="{StaticResource DangerDimBrush}" BorderBrush="{StaticResource DangerBrush}"
                BorderThickness="0,0,0,1" Padding="20,8">
            <TextBlock x:Name="TextoAvisoTasas" Foreground="{StaticResource DangerBrush}" />
        </Border>

        <!-- Aviso de caja -->
        <Border Grid.Row="2" x:Name="AvisoCaja" Visibility="Collapsed"
                Background="#1FF5B45B" BorderBrush="{StaticResource WarningBrush}"
                BorderThickness="0,0,0,1" Padding="20,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TextoAvisoCaja" Foreground="{StaticResource WarningBrush}"
                           VerticalAlignment="Center" TextWrapping="Wrap" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0"
                            VerticalAlignment="Center">
                    <Button x:Name="BotonAbrirCaja" Content="ABRIR CAJA"
                            Style="{StaticResource SecondaryButton}" Padding="12,6"
                            Visibility="Collapsed" Click="AbrirCaja_Click" />
                    <Button x:Name="BotonReabrirCaja" Content="REABRIR CAJA"
                            Style="{StaticResource SecondaryButton}" Padding="12,6"
                            Visibility="Collapsed" Click="ReabrirCaja_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Venta / pendientes -->
        <Grid Grid.Row="3" Margin="20,16,20,12">
            <TabControl x:Name="TabControlPrincipal" SelectionChanged="Tabs_SelectionChanged">
            <TabItem Header="Venta">
                <Grid Margin="0,16,0,0">
                    <!-- Carrito -->
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="0">
                            <Grid>
                                <DataGrid x:Name="TablaCarrito" AutoGenerateColumns="False" IsReadOnly="True"
                                          BorderThickness="0" Background="Transparent" RowHeight="40">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="CANT." Binding="{Binding Cantidad}" Width="60"
                                                            CellStyle="{StaticResource CeldaCentrada}"
                                                            ElementStyle="{StaticResource CeldaCantidad}" />
                                        <DataGridTemplateColumn Header="PRODUCTO" Width="*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Nombre}" TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding Nombre}" VerticalAlignment="Center"
                                                               HorizontalAlignment="Center" TextAlignment="Center" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="PESO" Binding="{Binding Peso}" Width="118"
                                                            CellStyle="{StaticResource CeldaCentrada}"
                                                            ElementStyle="{StaticResource CeldaCop}" />
                                        <DataGridTextColumn Header="BS" Binding="{Binding Bolivares}" Width="130"
                                                            CellStyle="{StaticResource CeldaCentrada}"
                                                            ElementStyle="{StaticResource CeldaBs}" />
                                        <DataGridTextColumn Header="DÓLARES" Binding="{Binding Dolares}" Width="100"
                                                            CellStyle="{StaticResource CeldaCentrada}"
                                                            ElementStyle="{StaticResource CeldaUsd}" />
                                        <DataGridTemplateColumn Header="ACCIONES" Width="185">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                                                HorizontalAlignment="Center">
                                                        <Button Content="+" Style="{StaticResource MiniOutlineSuccess}"
                                                                Click="Sumar_Click" />
                                                        <Button Content="−" Style="{StaticResource MiniOutlineMuted}"
                                                                Margin="5,0,0,0" Click="Restar_Click" />
                                                        <Button Content="Quitar" Style="{StaticResource MiniOutlineDanger}"
                                                                Margin="5,0,0,0" Click="Quitar_Click" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <StackPanel x:Name="CarritoVacio" VerticalAlignment="Center"
                                            HorizontalAlignment="Center">
                                    <TextBlock Text="Aún no hay productos en el carrito" FontSize="16"
                                               FontWeight="SemiBold" HorizontalAlignment="Center" />
                                    <TextBlock Text="Agrega (B) productos para comenzar"
                                               Style="{StaticResource MutedText}" Margin="0,8,0,0"
                                               HorizontalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Row="1" Margin="4,12,0,0">
                            <TextBlock x:Name="TextoTotales" FontSize="16" FontWeight="Bold"
                                       Text="Carrito vacío" />
                            <StackPanel x:Name="PanelTotales" Orientation="Horizontal"
                                        Visibility="Collapsed">
                                <TextBlock Text="TOTAL:" FontSize="16" FontWeight="Bold"
                                           VerticalAlignment="Center" Margin="0,0,14,0" />
                                <TextBlock x:Name="TotalCop" FontSize="16" FontWeight="Bold"
                                           Foreground="{StaticResource InfoBrush}" VerticalAlignment="Center" />
                                <TextBlock x:Name="TotalBs" FontSize="16" FontWeight="Bold"
                                           Foreground="{StaticResource DangerBrush}" VerticalAlignment="Center"
                                           Margin="18,0,0,0" />
                                <TextBlock x:Name="TotalUsd" FontSize="16" FontWeight="Bold"
                                           Foreground="{StaticResource MintBrush}" VerticalAlignment="Center"
                                           Margin="18,0,0,0" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Mismo orden que el POS web: crédito, descuento, reservar, cambio, vender, destruir. -->
                        <Grid Grid.Row="2" Margin="0,14,-10,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Button x:Name="BotonCredito" Grid.Row="0" Grid.Column="0" Content="CRÉDITO"
                                    Style="{StaticResource SecondaryButton}" Padding="16,10"
                                    Margin="0,0,10,10" Visibility="Collapsed" Click="Credito_Click" />
                            <Button x:Name="BotonDescuento" Grid.Row="0" Grid.Column="1"
                                    Content="DESCONTAR PRODUCTOS"
                                    Style="{StaticResource SecondaryButton}" Padding="16,10"
                                    Margin="0,0,10,10" Visibility="Collapsed" Click="Descuento_Click" />
                            <Button Grid.Row="0" Grid.Column="2" Content="RESERVAR CARRITO"
                                    Style="{StaticResource SecondaryButton}" Padding="16,10"
                                    Margin="0,0,10,10" Click="Reservar_Click" />
                            <Button Grid.Row="1" Grid.Column="0" Content="(C) CALCULAR CAMBIO"
                                    Style="{StaticResource SecondaryButton}" Padding="16,10"
                                    Margin="0,0,10,10" Click="Cambio_Click" />
                            <Button Grid.Row="1" Grid.Column="1" Content="(V) VENDER"
                                    Style="{StaticResource PrimaryButton}" Padding="20,10"
                                    Margin="0,0,10,10" Click="Vender_Click" />
                            <Button Grid.Row="1" Grid.Column="2" Content="DESTRUIR CARRITO"
                                    Style="{StaticResource DangerButton}" Padding="16,10"
                                    Margin="0,0,10,10" Click="Destruir_Click" />
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem x:Name="TabPendientes">
                <TabItem.Header>
                    <TextBlock x:Name="HeaderPendientes" Text="No guardados" />
                </TabItem.Header>
                <Grid Margin="0,16,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel x:Name="AccionesPendientes" Grid.Row="0" Orientation="Horizontal"
                                Margin="0,0,0,12" Visibility="Collapsed">
                        <TextBlock Text="Cajero:" Style="{StaticResource MutedText}"
                                   VerticalAlignment="Center" Margin="2,0,8,0" />
                        <ComboBox x:Name="FiltroCajero" Width="260" Height="32"
                                  SelectionChanged="FiltroCajero_SelectionChanged">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Nombre}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Content="ENVIAR DEL CAJERO" Style="{StaticResource SecondaryButton}"
                                Margin="10,0,0,0" Click="EnviarFiltrados_Click" />
                        <Button Content="ENVIAR TODOS" Style="{StaticResource PrimaryButton}"
                                Margin="10,0,0,0" Click="EnviarTodos_Click" />
                    </StackPanel>

                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
                        <DataGrid x:Name="TablaPendientes" AutoGenerateColumns="False" IsReadOnly="True"
                                  BorderThickness="0" Background="Transparent" RowHeight="40">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="FECHA" Binding="{Binding Fecha}" Width="105" CellStyle="{StaticResource CeldaCentrada}" ElementStyle="{StaticResource TextoEnCelda}" />
                                <DataGridTextColumn Header="CAJERO" Binding="{Binding Cajero}" Width="150" CellStyle="{StaticResource CeldaCentrada}" ElementStyle="{StaticResource TextoEnCelda}" />
                                <DataGridTextColumn Header="TIPO" Binding="{Binding Tipo}" Width="85" CellStyle="{StaticResource CeldaCentrada}" ElementStyle="{StaticResource TextoEnCelda}" />
                                <DataGridTextColumn Header="MÉTODO" Binding="{Binding Metodo}" Width="115" CellStyle="{StaticResource CeldaCentrada}" ElementStyle="{StaticResource TextoEnCelda}" />
                                <DataGridTextColumn Header="PESOS" Binding="{Binding Pesos}" Width="110" CellStyle="{StaticResource CeldaCentrada}" ElementStyle="{StaticResource TextoEnCelda}" />
                                <DataGridTextColumn Header="BOLÍVARES" Binding="{Binding Bolivares}" Width="125" CellStyle="{StaticResource CeldaCentrada}" ElementStyle="{StaticResource TextoEnCelda}" />
                                <DataGridTextColumn Header="DÓLARES" Binding="{Binding Dolares}" Width="95" CellStyle="{StaticResource CeldaCentrada}" ElementStyle="{StaticResource TextoEnCelda}" />
                                <DataGridTextColumn Header="ESTADO" Binding="{Binding Estado}" Width="105" CellStyle="{StaticResource CeldaCentrada}" ElementStyle="{StaticResource TextoEnCelda}" />
                                <DataGridTextColumn Header="DETALLE" Binding="{Binding Detalle}" Width="*" CellStyle="{StaticResource CeldaCentrada}" ElementStyle="{StaticResource TextoEnCelda}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <TextBlock x:Name="HeaderReservados" Text="Reservados" />
                </TabItem.Header>
                <Grid Margin="0,16,0,0">
                    <Border Style="{StaticResource Card}" Padding="0">
                        <DataGrid x:Name="TablaReservados" AutoGenerateColumns="False" IsReadOnly="True"
                                  BorderThickness="0" Background="Transparent" RowHeight="40">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="FECHA" Binding="{Binding Fecha}" Width="110" CellStyle="{StaticResource CeldaCentrada}" ElementStyle="{StaticResource TextoEnCelda}" />
                                <DataGridTextColumn Header="CLIENTE" Binding="{Binding Cliente}" Width="*" CellStyle="{StaticResource CeldaCentrada}" ElementStyle="{StaticResource TextoEnCelda}" />
                                <DataGridTextColumn Header="PRODUCTOS" Binding="{Binding Productos}" Width="120" CellStyle="{StaticResource CeldaCentrada}" ElementStyle="{StaticResource TextoEnCelda}" />
                                <DataGridTextColumn Header="PESOS" Binding="{Binding Pesos}" Width="120" CellStyle="{StaticResource CeldaCentrada}" ElementStyle="{StaticResource TextoEnCelda}" />
                                <DataGridTextColumn Header="BOLÍVARES" Binding="{Binding Bolivares}" Width="130" CellStyle="{StaticResource CeldaCentrada}" ElementStyle="{StaticResource TextoEnCelda}" />
                                <DataGridTextColumn Header="DÓLARES" Binding="{Binding Dolares}" Width="100" CellStyle="{StaticResource CeldaCentrada}" ElementStyle="{StaticResource TextoEnCelda}" />
                                <DataGridTemplateColumn Header="ACCIONES" Width="190">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                                        HorizontalAlignment="Center">
                                                <Button Content="Retomar" Style="{StaticResource MiniOutlineSuccess}"
                                                        Click="Retomar_Click" />
                                                <Button Content="Eliminar" Style="{StaticResource MiniOutlineDanger}"
                                                        Margin="5,0,0,0" Click="EliminarReservado_Click" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <TextBlock x:Name="HeaderEnviados" Text="Enviados" />
                </TabItem.Header>
                <Grid Margin="0,16,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Solo el administrador sincroniza lo que enviaron los demás cajeros. -->
                    <StackPanel x:Name="AccionesEnviados" Grid.Row="0" Orientation="Horizontal"
                                Margin="0,0,0,12" Visibility="Collapsed">
                        <TextBlock Text="Ventas enviadas por todos los cajeros."
                                   Style="{StaticResource MutedText}" VerticalAlignment="Center"
                                   Margin="2,0,14,0" />
                        <Button Content="SINCRONIZAR LO PENDIENTE" Style="{StaticResource SecondaryButton}"
                                Click="EnviarTodos_Click" />
                    </StackPanel>

                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
                        <DataGrid x:Name="TablaEnviados" AutoGenerateColumns="False" IsReadOnly="True"
                                  BorderThickness="0" Background="Transparent" RowHeight="40">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="FECHA" Binding="{Binding Fecha}" Width="110" CellStyle="{StaticResource CeldaCentrada}" ElementStyle="{StaticResource TextoEnCelda}" />
                                <DataGridTextColumn Header="CAJERO" Binding="{Binding Venta.UsuarioNombre}" Width="150" CellStyle="{StaticResource CeldaCentrada}" ElementStyle="{StaticResource TextoEnCelda}" />
                                <DataGridTextColumn Header="TIPO" Binding="{Binding Tipo}" Width="90" CellStyle="{StaticResource CeldaCentrada}" ElementStyle="{StaticResource TextoEnCelda}" />
                                <DataGridTextColumn Header="MÉTODO" Binding="{Binding Metodo}" Width="120" CellStyle="{StaticResource CeldaCentrada}" ElementStyle="{StaticResource TextoEnCelda}" />
                                <DataGridTextColumn Header="PESOS" Binding="{Binding Pesos}" Width="120"
                                                    ElementStyle="{StaticResource CeldaCop}" CellStyle="{StaticResource CeldaCentrada}" />
                                <DataGridTextColumn Header="BOLÍVARES" Binding="{Binding Bolivares}" Width="140"
                                                    ElementStyle="{StaticResource CeldaBs}" CellStyle="{StaticResource CeldaCentrada}" />
                                <DataGridTextColumn Header="DÓLARES" Binding="{Binding Dolares}" Width="110"
                                                    ElementStyle="{StaticResource CeldaUsd}" CellStyle="{StaticResource CeldaCentrada}" />
                                <DataGridTextColumn Header="ESTADO" Binding="{Binding Estado}" Width="*" CellStyle="{StaticResource CeldaCentrada}" ElementStyle="{StaticResource TextoEnCelda}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>
            </TabControl>

            <!-- En la misma línea de las pestañas: primero cerrar caja, luego búsqueda. -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,3,0,0">
                <Button x:Name="BotonCerrarCaja" Content="CERRAR CAJA"
                        Style="{StaticResource DangerButton}" Padding="14,7"
                        Visibility="Collapsed" Click="CerrarCaja_Click" />
                <Button Content="(B) BÚSQUEDA" Style="{StaticResource PrimaryButton}"
                        Padding="16,7" Margin="8,0,0,0" Click="Buscar_Click" />
            </StackPanel>
        </Grid>

        <!-- Barra de estado -->
        <Border Grid.Row="4" Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TextoEstado" Grid.Column="0" Style="{StaticResource MutedText}"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="·" Style="{StaticResource MutedText}"
                           Margin="10,0" VerticalAlignment="Center" />
                <TextBlock x:Name="TextoEstadoConexion" Grid.Column="2" Text="Comprobando…"
                           Style="{StaticResource MutedText}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="TextoTasas" Grid.Column="3" Style="{StaticResource MutedText}"
                           VerticalAlignment="Center" Margin="16,0,0,0" Visibility="Collapsed" />
                <TextBlock x:Name="TextoCatalogo" Grid.Column="4" Style="{StaticResource MutedText}"
                           VerticalAlignment="Center" Margin="16,0,0,0" />
            </Grid>
        </Border>
    </Grid>
</Window>

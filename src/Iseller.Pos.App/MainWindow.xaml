<Window x:Class="Iseller.Pos.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:Iseller.Pos.App"
        Title="iSeller POS" Height="820" Width="1400"
        MinHeight="640" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Icon="Assets/logo1-inv-compact-128.png"
        Style="{StaticResource PosWindow}"
        PreviewKeyDown="Window_PreviewKeyDown">

    <!-- Mantiene el redimensionado nativo aunque la barra del sistema esté oculta. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Colores por moneda, iguales al POS web, y valores centrados en su columna. -->
        <Style x:Key="CeldaCantidad" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Center" />
        </Style>
        <Style x:Key="CeldaCop" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource InfoBrush}" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>
        <Style x:Key="CeldaBs" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>
        <Style x:Key="CeldaUsd" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MintBrush}" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="32" />
        </Grid.RowDefinitions>

        <!-- Cabecera (hace de barra de título) -->
        <Border Grid.Row="0" Background="{StaticResource BgBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="Barra_MouseLeftButtonDown">
            <Grid Margin="20,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="Assets/logo1-inv-compact-128.png" Width="30" Height="30"
                           Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="iSELLER" FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource MintBrush}" />
                    <TextBlock Text="POS" FontSize="16" FontWeight="Bold" Margin="6,0,0,0" />
                    <TextBlock x:Name="TextoSucursal" Style="{StaticResource MutedText}"
                               Margin="24,0,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Ellipse x:Name="PuntoConexion" Width="8" Height="8"
                             Fill="{StaticResource WarningBrush}" Margin="0,0,8,0" />
                    <TextBlock x:Name="TextoEstadoConexion" Text="Comprobando…"
                               Style="{StaticResource MutedText}" VerticalAlignment="Center"
                               Margin="0,0,16,0" />
                    <Button Content="AJUSTES" Style="{StaticResource SecondaryButton}" Padding="12,6"
                            Click="Ajustes_Click" />
                    <Button Style="{StaticResource SecondaryButton}" Padding="12,6"
                            Margin="8,0,0,0" Click="Actualizar_Click"
                            ToolTip="Buscar si hay una versión nueva del POS">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M12,3 L12,15 M6,9 L12,15 L18,9 M4,20 L20,20"
                                  Stroke="{StaticResource TextBrush}" StrokeThickness="2.4"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Stretch="Uniform" Width="14" Height="14"
                                  VerticalAlignment="Center" Margin="0,0,7,0" />
                            <TextBlock Text="VERIFICAR ACTUALIZACIONES" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnMinimizar" Style="{StaticResource WindowButton}" Margin="12,0,0,0"
                            ToolTip="Minimizar" Click="Minimizar_Click">
                        <Path Data="M0,0 L11,0" Stroke="White" StrokeThickness="1.2" />
                    </Button>
                    <Button x:Name="BtnCerrar" Style="{StaticResource WindowCloseButton}"
                            ToolTip="Cerrar" Click="Cerrar_Click">
                        <Path Data="M0,0 L11,11 M11,0 L0,11" Stroke="White" StrokeThickness="1.2" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Aviso de tasa vieja -->
        <Border Grid.Row="1" x:Name="AvisoTasas" Visibility="Collapsed"
                Background="{StaticResource DangerDimBrush}" BorderBrush="{StaticResource DangerBrush}"
                BorderThickness="0,0,0,1" Padding="20,8">
            <TextBlock x:Name="TextoAvisoTasas" Foreground="{StaticResource DangerBrush}" />
        </Border>

        <!-- Aviso de caja -->
        <Border Grid.Row="2" x:Name="AvisoCaja" Visibility="Collapsed"
                Background="#1FF5B45B" BorderBrush="{StaticResource WarningBrush}"
                BorderThickness="0,0,0,1" Padding="20,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TextoAvisoCaja" Foreground="{StaticResource WarningBrush}"
                           VerticalAlignment="Center" TextWrapping="Wrap" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0"
                            VerticalAlignment="Center">
                    <Button x:Name="BotonAbrirCaja" Content="ABRIR CAJA"
                            Style="{StaticResource SecondaryButton}" Padding="12,6"
                            Visibility="Collapsed" Click="AbrirCaja_Click" />
                    <Button x:Name="BotonReabrirCaja" Content="REABRIR CAJA"
                            Style="{StaticResource SecondaryButton}" Padding="12,6"
                            Visibility="Collapsed" Click="ReabrirCaja_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Venta / pendientes -->
        <TabControl x:Name="TabControlPrincipal" Grid.Row="3" Margin="20,16,20,12"
                    SelectionChanged="Tabs_SelectionChanged">
            <TabItem Header="Venta">
                <Grid Margin="0,16,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="(B) BÚSQUEDA" Style="{StaticResource PrimaryButton}"
                                    Padding="18,10" Click="Buscar_Click" />
                            <Button Content="SINCRONIZAR CATÁLOGO" Style="{StaticResource SecondaryButton}"
                                    Margin="10,0,0,0" Click="Sincronizar_Click" />
                            <Button Content="ENVIAR PENDIENTES" Style="{StaticResource SecondaryButton}"
                                    Margin="10,0,0,0" Click="Enviar_Click" />
                            <Button Content="VERIFICAR CONEXIÓN" Style="{StaticResource SecondaryButton}"
                                    Margin="10,0,0,0" Click="Verificar_Click" />
                        </StackPanel>
                        <Button x:Name="BotonCerrarCaja" Content="CERRAR CAJA"
                                Style="{StaticResource DangerButton}" Padding="16,10"
                                HorizontalAlignment="Right" Visibility="Collapsed" Click="CerrarCaja_Click" />
                    </Grid>

                    <!-- Carrito -->
                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="0">
                            <Grid>
                                <DataGrid x:Name="TablaCarrito" AutoGenerateColumns="False" IsReadOnly="True"
                                          BorderThickness="0" Background="Transparent" RowHeight="40">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="CANT." Binding="{Binding Cantidad}" Width="60"
                                                            CellStyle="{StaticResource CeldaCentrada}"
                                                            ElementStyle="{StaticResource CeldaCantidad}" />
                                        <DataGridTemplateColumn Header="PRODUCTO" Width="*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Nombre}" TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding Nombre}" VerticalAlignment="Center" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="PESO" Binding="{Binding Peso}" Width="118"
                                                            CellStyle="{StaticResource CeldaCentrada}"
                                                            ElementStyle="{StaticResource CeldaCop}" />
                                        <DataGridTextColumn Header="BS" Binding="{Binding Bolivares}" Width="130"
                                                            CellStyle="{StaticResource CeldaCentrada}"
                                                            ElementStyle="{StaticResource CeldaBs}" />
                                        <DataGridTextColumn Header="DÓLARES" Binding="{Binding Dolares}" Width="100"
                                                            CellStyle="{StaticResource CeldaCentrada}"
                                                            ElementStyle="{StaticResource CeldaUsd}" />
                                        <DataGridTemplateColumn Header="ACCIONES" Width="185">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Content="+" Style="{StaticResource MiniOutlineSuccess}"
                                                                Click="Sumar_Click" />
                                                        <Button Content="−" Style="{StaticResource MiniOutlineMuted}"
                                                                Margin="5,0,0,0" Click="Restar_Click" />
                                                        <Button Content="Quitar" Style="{StaticResource MiniOutlineDanger}"
                                                                Margin="5,0,0,0" Click="Quitar_Click" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <StackPanel x:Name="CarritoVacio" VerticalAlignment="Center"
                                            HorizontalAlignment="Center">
                                    <TextBlock Text="Aún no hay productos en el carrito" FontSize="16"
                                               FontWeight="SemiBold" HorizontalAlignment="Center" />
                                    <TextBlock Text="Agrega (B) productos para comenzar"
                                               Style="{StaticResource MutedText}" Margin="0,8,0,0"
                                               HorizontalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Row="1" Margin="4,12,0,0">
                            <TextBlock x:Name="TextoTotales" FontSize="16" FontWeight="Bold"
                                       Text="Carrito vacío" />
                            <StackPanel x:Name="PanelTotales" Orientation="Horizontal"
                                        Visibility="Collapsed">
                                <TextBlock Text="TOTAL:" FontSize="16" FontWeight="Bold"
                                           VerticalAlignment="Center" Margin="0,0,14,0" />
                                <TextBlock x:Name="TotalCop" FontSize="16" FontWeight="Bold"
                                           Foreground="{StaticResource InfoBrush}" VerticalAlignment="Center" />
                                <TextBlock x:Name="TotalBs" FontSize="16" FontWeight="Bold"
                                           Foreground="{StaticResource DangerBrush}" VerticalAlignment="Center"
                                           Margin="18,0,0,0" />
                                <TextBlock x:Name="TotalUsd" FontSize="16" FontWeight="Bold"
                                           Foreground="{StaticResource MintBrush}" VerticalAlignment="Center"
                                           Margin="18,0,0,0" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Mismo orden que el POS web: crédito, descuento, reservar, cambio, vender, destruir. -->
                        <Grid Grid.Row="2" Margin="0,14,-10,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Button x:Name="BotonCredito" Grid.Row="0" Grid.Column="0" Content="CRÉDITO"
                                    Style="{StaticResource SecondaryButton}" Padding="16,10"
                                    Margin="0,0,10,10" Visibility="Collapsed" Click="Credito_Click" />
                            <Button x:Name="BotonDescuento" Grid.Row="0" Grid.Column="1"
                                    Content="DESCONTAR PRODUCTOS"
                                    Style="{StaticResource SecondaryButton}" Padding="16,10"
                                    Margin="0,0,10,10" Visibility="Collapsed" Click="Descuento_Click" />
                            <Button Grid.Row="0" Grid.Column="2" Content="RESERVAR CARRITO"
                                    Style="{StaticResource SecondaryButton}" Padding="16,10"
                                    Margin="0,0,10,10" Click="Reservar_Click" />
                            <Button Grid.Row="1" Grid.Column="0" Content="(C) CALCULAR CAMBIO"
                                    Style="{StaticResource SecondaryButton}" Padding="16,10"
                                    Margin="0,0,10,10" Click="Cambio_Click" />
                            <Button Grid.Row="1" Grid.Column="1" Content="(V) VENDER"
                                    Style="{StaticResource PrimaryButton}" Padding="20,10"
                                    Margin="0,0,10,10" Click="Vender_Click" />
                            <Button Grid.Row="1" Grid.Column="2" Content="DESTRUIR CARRITO"
                                    Style="{StaticResource DangerButton}" Padding="16,10"
                                    Margin="0,0,10,10" Click="Destruir_Click" />
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem x:Name="TabPendientes">
                <TabItem.Header>
                    <TextBlock x:Name="HeaderPendientes" Text="No guardados" />
                </TabItem.Header>
                <Grid Margin="0,16,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel x:Name="AccionesPendientes" Grid.Row="0" Orientation="Horizontal"
                                Margin="0,0,0,12" Visibility="Collapsed">
                        <TextBlock Text="Cajero:" Style="{StaticResource MutedText}"
                                   VerticalAlignment="Center" Margin="2,0,8,0" />
                        <ComboBox x:Name="FiltroCajero" Width="260" Height="32"
                                  SelectionChanged="FiltroCajero_SelectionChanged">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Nombre}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Content="ENVIAR DEL CAJERO" Style="{StaticResource SecondaryButton}"
                                Margin="10,0,0,0" Click="EnviarFiltrados_Click" />
                        <Button Content="ENVIAR TODOS" Style="{StaticResource PrimaryButton}"
                                Margin="10,0,0,0" Click="EnviarTodos_Click" />
                    </StackPanel>

                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
                        <DataGrid x:Name="TablaPendientes" AutoGenerateColumns="False" IsReadOnly="True"
                                  BorderThickness="0" Background="Transparent" RowHeight="40">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="FECHA" Binding="{Binding Fecha}" Width="105" />
                                <DataGridTextColumn Header="CAJERO" Binding="{Binding Cajero}" Width="150" />
                                <DataGridTextColumn Header="TIPO" Binding="{Binding Tipo}" Width="85" />
                                <DataGridTextColumn Header="MÉTODO" Binding="{Binding Metodo}" Width="115" />
                                <DataGridTextColumn Header="PESOS" Binding="{Binding Pesos}" Width="110" />
                                <DataGridTextColumn Header="BOLÍVARES" Binding="{Binding Bolivares}" Width="125" />
                                <DataGridTextColumn Header="DÓLARES" Binding="{Binding Dolares}" Width="95" />
                                <DataGridTextColumn Header="ESTADO" Binding="{Binding Estado}" Width="105" />
                                <DataGridTextColumn Header="DETALLE" Binding="{Binding Detalle}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <TextBlock x:Name="HeaderReservados" Text="Reservados" />
                </TabItem.Header>
                <Grid Margin="0,16,0,0">
                    <Border Style="{StaticResource Card}" Padding="0">
                        <DataGrid x:Name="TablaReservados" AutoGenerateColumns="False" IsReadOnly="True"
                                  BorderThickness="0" Background="Transparent" RowHeight="40">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="FECHA" Binding="{Binding Fecha}" Width="110" />
                                <DataGridTextColumn Header="CLIENTE" Binding="{Binding Cliente}" Width="*" />
                                <DataGridTextColumn Header="PRODUCTOS" Binding="{Binding Productos}" Width="120" />
                                <DataGridTextColumn Header="PESOS" Binding="{Binding Pesos}" Width="120" />
                                <DataGridTextColumn Header="BOLÍVARES" Binding="{Binding Bolivares}" Width="130" />
                                <DataGridTextColumn Header="DÓLARES" Binding="{Binding Dolares}" Width="100" />
                                <DataGridTemplateColumn Header="ACCIONES" Width="190">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="Retomar" Style="{StaticResource MiniOutlineSuccess}"
                                                        Click="Retomar_Click" />
                                                <Button Content="Eliminar" Style="{StaticResource MiniOutlineDanger}"
                                                        Margin="5,0,0,0" Click="EliminarReservado_Click" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <TextBlock x:Name="HeaderEnviados" Text="Enviados" />
                </TabItem.Header>
                <Grid Margin="0,16,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Solo el administrador sincroniza lo que enviaron los demás cajeros. -->
                    <StackPanel x:Name="AccionesEnviados" Grid.Row="0" Orientation="Horizontal"
                                Margin="0,0,0,12" Visibility="Collapsed">
                        <TextBlock Text="Ventas enviadas por todos los cajeros."
                                   Style="{StaticResource MutedText}" VerticalAlignment="Center"
                                   Margin="2,0,14,0" />
                        <Button Content="SINCRONIZAR LO PENDIENTE" Style="{StaticResource SecondaryButton}"
                                Click="EnviarTodos_Click" />
                    </StackPanel>

                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
                        <DataGrid x:Name="TablaEnviados" AutoGenerateColumns="False" IsReadOnly="True"
                                  BorderThickness="0" Background="Transparent" RowHeight="40">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="FECHA" Binding="{Binding Fecha}" Width="110" />
                                <DataGridTextColumn Header="CAJERO" Binding="{Binding Venta.UsuarioNombre}" Width="150" />
                                <DataGridTextColumn Header="TIPO" Binding="{Binding Tipo}" Width="90" />
                                <DataGridTextColumn Header="MÉTODO" Binding="{Binding Metodo}" Width="120" />
                                <DataGridTextColumn Header="PESOS" Binding="{Binding Pesos}" Width="120"
                                                    ElementStyle="{StaticResource CeldaCop}" />
                                <DataGridTextColumn Header="BOLÍVARES" Binding="{Binding Bolivares}" Width="140"
                                                    ElementStyle="{StaticResource CeldaBs}" />
                                <DataGridTextColumn Header="DÓLARES" Binding="{Binding Dolares}" Width="110"
                                                    ElementStyle="{StaticResource CeldaUsd}" />
                                <DataGridTextColumn Header="ESTADO" Binding="{Binding Estado}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Barra de estado -->
        <Border Grid.Row="4" Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="20,0">
                <TextBlock x:Name="TextoEstado" Style="{StaticResource MutedText}"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="TextoCatalogo" Style="{StaticResource MutedText}"
                           HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>

<Window x:Class="Iseller.Pos.App.VentanaBusqueda"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:Iseller.Pos.App"
        Title="Búsqueda de productos" Width="1120" Height="660"
        MinWidth="820" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        Icon="Assets/logo1-inv-compact-128.png"
        Style="{StaticResource PosWindow}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="38" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="32" />
        </Grid.RowDefinitions>

        <!-- Barra superior -->
        <Border Grid.Row="0" Background="{StaticResource BgBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="Barra_MouseLeftButtonDown">
            <Grid Margin="16,0,8,0">
                <TextBlock Text="Búsqueda de productos" Style="{StaticResource MutedText}"
                           VerticalAlignment="Center" />
                <Button x:Name="BtnCerrar" Style="{StaticResource WindowCloseButton}"
                        HorizontalAlignment="Right" ToolTip="Cerrar (Esc)" Click="Cerrar_Click">
                    <Path Data="M0,0 L11,11 M11,0 L0,11" Stroke="White" StrokeThickness="1.2" />
                </Button>
            </Grid>
        </Border>

        <!-- Buscador -->
        <StackPanel Grid.Row="1" Margin="20,16,20,10">
            <TextBlock Text="Buscar por nombre o escanear un código (Enter agrega)"
                       Style="{StaticResource MutedText}" Margin="2,0,0,6" />
            <TextBox x:Name="CampoBusqueda" Padding="14,11" FontSize="16"
                     TextChanged="CampoBusqueda_TextChanged"
                     KeyDown="CampoBusqueda_KeyDown" />
        </StackPanel>

        <!-- Resultados -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0" Margin="20,0,20,12">
            <Grid>
                <DataGrid x:Name="TablaResultados" AutoGenerateColumns="False" IsReadOnly="True"
                          BorderThickness="0" Background="Transparent" RowHeight="52"
                          MouseDoubleClick="TablaResultados_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="" Width="56">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Width="40" Height="40" CornerRadius="6"
                                            Background="#0AFFFFFF" ClipToBounds="True"
                                            VerticalAlignment="Center">
                                        <Grid>
                                            <Path Data="M4,10 L9,14 L13,9 L17,14 M4,6 A1.2,1.2 0 1 0 4,6.01 M3,3 L19,3 L19,19 L3,19 Z"
                                                  Stroke="#4D8892A0" StrokeThickness="1.3" Stretch="Uniform"
                                                  Margin="9" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <Image Source="{Binding Imagen}" Stretch="UniformToFill" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="PRODUCTO" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Nombre}" TextWrapping="Wrap"
                                               ToolTip="{Binding Nombre}" VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="STOCK" Binding="{Binding Stock}" Width="72" />
                        <DataGridTextColumn Header="DÓLARES" Binding="{Binding PrecioDolar}" Width="92" />
                        <DataGridTextColumn Header="BOLÍVARES" Binding="{Binding PrecioBs}" Width="120" />
                        <DataGridTextColumn Header="PESOS" Binding="{Binding PrecioPeso}" Width="120" />
                        <DataGridTemplateColumn Header="CANT." Width="76">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding CantidadTexto, UpdateSourceTrigger=PropertyChanged}"
                                             Padding="6,4" FontSize="12" HorizontalContentAlignment="Center"
                                             VerticalAlignment="Center" app:Numerico.Decimales="True" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="AGREGAR" Style="{StaticResource PrimaryButton}"
                                            Padding="10,5" FontSize="11" VerticalAlignment="Center"
                                            Click="Agregar_Click" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel x:Name="MensajeVacio" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="Escribe el nombre o escanea un código" FontSize="16"
                               FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="Con Enter se agrega el código exacto al carrito."
                               Style="{StaticResource MutedText}" Margin="0,8,0,0" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="3" Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="20,0">
                <TextBlock x:Name="TextoEstado" Style="{StaticResource MutedText}"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="TextoResultados" Style="{StaticResource MutedText}"
                           HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>

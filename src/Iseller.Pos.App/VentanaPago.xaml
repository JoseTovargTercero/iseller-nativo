<Window x:Class="Iseller.Pos.App.VentanaPago"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:Iseller.Pos.App"
        Title="Confirmar" Width="560" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Icon="Assets/logo1-inv-compact-128.png"
        Style="{StaticResource PosWindow}"
        PreviewKeyDown="Ventana_PreviewKeyDown">

    <StackPanel Margin="24">
        <TextBlock Text="Resumen del despacho" Style="{StaticResource SectionTitle}" />
        <TextBlock x:Name="TextoTipo" Style="{StaticResource MutedText}" Margin="0,2,0,12" />

        <Border Style="{StaticResource Card}" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="PESOS" Style="{StaticResource MutedText}" />
                    <TextBlock x:Name="TextoPesos" Foreground="{StaticResource InfoBrush}"
                               FontWeight="Bold" FontSize="15" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="BOLÍVARES" Style="{StaticResource MutedText}" />
                    <TextBlock x:Name="TextoBolivares" Foreground="{StaticResource DangerBrush}"
                               FontWeight="Bold" FontSize="15" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="DÓLARES" Style="{StaticResource MutedText}" />
                    <TextBlock x:Name="TextoDolares" Foreground="{StaticResource MintBrush}"
                               FontWeight="Bold" FontSize="15" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Indicador de pasos: solo con pago fraccionado -->
        <StackPanel x:Name="Wizard" Orientation="Horizontal" Margin="0,14,0,0" Visibility="Collapsed">
            <TextBlock x:Name="Paso1Texto" Text="1 · Despacho" FontWeight="Bold" VerticalAlignment="Center" />
            <Border Width="26" Height="1" Background="{StaticResource BorderBrush}" Margin="8,0"
                    VerticalAlignment="Center" />
            <TextBlock x:Name="Paso2Texto" Text="2 · Fracciones" VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel x:Name="PanelPago" Margin="0,16,0,0">
            <TextBlock Text="Método de pago" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
            <TextBlock Text="(1) Punto  (2) BioPago  (3) Pesos  (4) Efectivo"
                       Style="{StaticResource MutedText}" FontSize="11" />
            <TextBlock Text="(5) Pago Móvil  (6) Transferencia  (7) Dólares  (8) Fraccionado"
                       Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,6" />
            <ComboBox x:Name="ComboPago" Height="34" SelectedValuePath="Clave"
                      SelectionChanged="ComboPago_SelectionChanged">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Texto}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </StackPanel>

        <StackPanel x:Name="PanelCliente" Margin="0,18,0,0" Visibility="Collapsed">
            <TextBlock Text="Cédula del cliente" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
            <TextBox x:Name="CampoCedula" Padding="10,8" TextChanged="CampoCedula_TextChanged" />
            <TextBlock Text="Nombre del cliente" Style="{StaticResource MutedText}" Margin="0,10,0,4" />
            <TextBox x:Name="CampoNombre" Padding="10,8" />
            <TextBlock Text="Teléfono del cliente" Style="{StaticResource MutedText}" Margin="0,10,0,4" />
            <TextBox x:Name="CampoTelefono" Padding="10,8" MaxLength="11" />
        </StackPanel>

        <!-- Paso 2: fracciones del pago -->
        <StackPanel x:Name="PanelFraccionado" Margin="0,16,0,0" Visibility="Collapsed">
            <Border Style="{StaticResource Card}" Padding="12">
                <StackPanel>
                    <TextBlock Text="Falta por pagar" Style="{StaticResource SectionTitle}" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock x:Name="FaltaCop" Foreground="{StaticResource InfoBrush}"
                                   FontWeight="Bold" FontSize="16" VerticalAlignment="Center" />
                        <TextBlock x:Name="FaltaBs" Foreground="{StaticResource DangerBrush}"
                                   FontWeight="Bold" FontSize="16" VerticalAlignment="Center" Margin="18,0,0,0" />
                        <TextBlock x:Name="FaltaUsd" Foreground="{StaticResource MintBrush}"
                                   FontWeight="Bold" FontSize="16" VerticalAlignment="Center" Margin="18,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,10">
                    <TextBlock Text="Punto (Bs)" Style="{StaticResource MutedText}" FontSize="10" />
                    <TextBox x:Name="FracPunto" Padding="8,6" app:Numerico.Decimales="True"
                             TextChanged="Fraccion_TextChanged" />
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,10">
                    <TextBlock Text="BioPago (Bs)" Style="{StaticResource MutedText}" FontSize="10" />
                    <TextBox x:Name="FracBioPago" Padding="8,6" app:Numerico.Decimales="True"
                             TextChanged="Fraccion_TextChanged" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,10">
                    <TextBlock Text="Pago móvil (Bs)" Style="{StaticResource MutedText}" FontSize="10" />
                    <TextBox x:Name="FracPagoMovil" Padding="8,6" app:Numerico.Decimales="True"
                             TextChanged="Fraccion_TextChanged" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,10">
                    <TextBlock Text="Transferencia (Bs)" Style="{StaticResource MutedText}" FontSize="10" />
                    <TextBox x:Name="FracTransferencia" Padding="8,6" app:Numerico.Decimales="True"
                             TextChanged="Fraccion_TextChanged" />
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,8,10">
                    <TextBlock Text="Efectivo (Bs)" Style="{StaticResource MutedText}" FontSize="10" />
                    <TextBox x:Name="FracEfectivo" Padding="8,6" app:Numerico.Decimales="True"
                             TextChanged="Fraccion_TextChanged" />
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="1" Margin="8,0,0,10">
                    <TextBlock Text="Dólares (USD)" Style="{StaticResource MutedText}" FontSize="10" />
                    <TextBox x:Name="FracDolares" Padding="8,6" app:Numerico.Decimales="True"
                             TextChanged="Fraccion_TextChanged" />
                </StackPanel>
                <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock Text="Pesos (COP)" Style="{StaticResource MutedText}" FontSize="10" />
                    <TextBox x:Name="FracPesos" Padding="8,6" app:Numerico.Decimales="True"
                             TextChanged="Fraccion_TextChanged" />
                </StackPanel>
                <Button Grid.Row="3" Grid.Column="1" Content="Limpiar" Style="{StaticResource SecondaryButton}"
                        Padding="12,6" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Margin="8,0,0,0" Click="Limpiar_Click" />
            </Grid>

            <TextBlock x:Name="EstadoFraccionado" Style="{StaticResource MutedText}"
                       Margin="0,12,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <TextBlock x:Name="TextoError" Foreground="{StaticResource DangerBrush}"
                   Margin="0,12,0,0" TextWrapping="Wrap" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="BotonAtras" Content="ATRÁS" Style="{StaticResource SecondaryButton}"
                    Padding="16,9" Visibility="Collapsed" Click="Atras_Click" />
            <Button x:Name="BotonCancelar" Content="Cancelar" Style="{StaticResource SecondaryButton}"
                    Padding="16,9" Margin="10,0,0,0" Click="Cancelar_Click" />
            <Button x:Name="BotonContinuar" Content="CONTINUAR" Style="{StaticResource PrimaryButton}"
                    Padding="16,9" Margin="10,0,0,0" Click="Continuar_Click" />
        </StackPanel>
    </StackPanel>
</Window>

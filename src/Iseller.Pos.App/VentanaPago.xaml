<Window x:Class="Iseller.Pos.App.VentanaPago"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirmar" Width="460" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Icon="Assets/logo1-inv-compact-128.png"
        Style="{StaticResource PosWindow}"
        PreviewKeyDown="Ventana_PreviewKeyDown">

    <StackPanel Margin="24">
        <TextBlock Text="Resumen del despacho" Style="{StaticResource SectionTitle}" />
        <TextBlock x:Name="TextoTipo" Style="{StaticResource MutedText}" Margin="0,2,0,12" />

        <Border Style="{StaticResource Card}" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="PESOS" Style="{StaticResource MutedText}" />
                    <TextBlock x:Name="TextoPesos" Foreground="{StaticResource InfoBrush}"
                               FontWeight="Bold" FontSize="15" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="BOLÍVARES" Style="{StaticResource MutedText}" />
                    <TextBlock x:Name="TextoBolivares" Foreground="{StaticResource DangerBrush}"
                               FontWeight="Bold" FontSize="15" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="DÓLARES" Style="{StaticResource MutedText}" />
                    <TextBlock x:Name="TextoDolares" Foreground="{StaticResource MintBrush}"
                               FontWeight="Bold" FontSize="15" />
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel x:Name="PanelPago" Margin="0,18,0,0">
            <TextBlock Text="Método de pago" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
            <TextBlock Text="(1) Punto  (2) BioPago  (3) Pesos  (4) Efectivo"
                       Style="{StaticResource MutedText}" FontSize="11" />
            <TextBlock Text="(5) Pago Móvil  (6) Transferencia  (7) Dólares"
                       Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,6" />
            <ComboBox x:Name="ComboPago" Height="34" SelectedValuePath="Clave">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Texto}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </StackPanel>

        <StackPanel x:Name="PanelCliente" Margin="0,18,0,0" Visibility="Collapsed">
            <TextBlock Text="Cédula del cliente" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
            <TextBox x:Name="CampoCedula" Padding="10,8" TextChanged="CampoCedula_TextChanged" />
            <TextBlock Text="Nombre del cliente" Style="{StaticResource MutedText}" Margin="0,10,0,4" />
            <TextBox x:Name="CampoNombre" Padding="10,8" />
            <TextBlock Text="Teléfono del cliente" Style="{StaticResource MutedText}" Margin="0,10,0,4" />
            <TextBox x:Name="CampoTelefono" Padding="10,8" MaxLength="11" />
        </StackPanel>

        <TextBlock x:Name="TextoError" Foreground="{StaticResource DangerBrush}"
                   Margin="0,12,0,0" TextWrapping="Wrap" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Cancelar" Style="{StaticResource SecondaryButton}" Padding="16,9"
                    Click="Cancelar_Click" />
            <Button Content="CONTINUAR" Style="{StaticResource PrimaryButton}" Padding="16,9"
                    Margin="10,0,0,0" Click="Continuar_Click" />
        </StackPanel>
    </StackPanel>
</Window>

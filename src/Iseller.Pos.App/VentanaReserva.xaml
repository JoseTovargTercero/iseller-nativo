<Window x:Class="Iseller.Pos.App.VentanaReserva"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reservar carrito" Width="430" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Style="{StaticResource PosWindow}">

    <StackPanel Margin="24">
        <TextBlock Text="Identificador del carrito" Style="{StaticResource SectionTitle}" />
        <TextBlock Text="Puede ser el nombre del cliente o una referencia corta."
                   Style="{StaticResource MutedText}" Margin="0,4,0,12" TextWrapping="Wrap" />
        <TextBox x:Name="CampoCliente" Padding="12,10" FontSize="15" />

        <TextBlock x:Name="TextoError" Foreground="{StaticResource DangerBrush}" Margin="0,10,0,0" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancelar" Style="{StaticResource SecondaryButton}" Padding="16,9"
                    Click="Cancelar_Click" />
            <Button Content="RESERVAR" Style="{StaticResource PrimaryButton}" Padding="16,9"
                    Margin="10,0,0,0" Click="Reservar_Click" />
        </StackPanel>
    </StackPanel>
</Window>

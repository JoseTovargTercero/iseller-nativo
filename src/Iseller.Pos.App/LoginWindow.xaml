<Window x:Class="Iseller.Pos.App.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="iSeller POS — Acceso" Height="560" Width="420"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Style="{StaticResource PosWindow}">

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="iSELLER" FontSize="22" FontWeight="Bold"
                           Foreground="{StaticResource MintBrush}" />
                <TextBlock Text="POS" FontSize="22" FontWeight="Bold" Margin="6,0,0,0" />
            </StackPanel>
            <TextBlock Text="Acceso a la caja" Style="{StaticResource MutedText}" Margin="0,4,0,28" />

            <TextBlock Text="Usuario" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
            <TextBox x:Name="CampoUsuario" Padding="12,9" FontSize="15" />

            <TextBlock Text="Contraseña" Style="{StaticResource MutedText}" Margin="0,16,0,4" />
            <PasswordBox x:Name="CampoClave" Padding="12,9" FontSize="15"
                         Background="{StaticResource BgBrush}"
                         Foreground="{StaticResource TextBrush}"
                         BorderBrush="{StaticResource BorderBrush}"
                         KeyDown="CampoClave_KeyDown" />

            <StackPanel x:Name="PanelSucursal" Visibility="Collapsed" Margin="0,16,0,0">
                <TextBlock Text="Sucursal" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
                <ComboBox x:Name="ComboSucursal" DisplayMemberPath="Nombre" SelectedValuePath="Id"
                          Height="36" />
            </StackPanel>

            <Button x:Name="BotonEntrar" Content="ENTRAR" Style="{StaticResource PrimaryButton}"
                    Margin="0,26,0,0" Padding="14,11" Click="BotonEntrar_Click" />

            <Button x:Name="BotonOffline" Content="ENTRAR SIN CONEXIÓN"
                    Style="{StaticResource SecondaryButton}" Margin="0,10,0,0" Padding="14,11"
                    Visibility="Collapsed" Click="BotonOffline_Click" />

            <TextBlock x:Name="TextoEstado" Style="{StaticResource MutedText}" Margin="0,14,0,0"
                       TextWrapping="Wrap" />

            <Button Content="AJUSTES DE SERVIDOR E IMPRESORA" Style="{StaticResource SecondaryButton}"
                    Margin="0,18,0,0" Padding="14,10" Click="Ajustes_Click" />
        </StackPanel>
    </Grid>
</Window>

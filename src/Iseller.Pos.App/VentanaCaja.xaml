<Window x:Class="Iseller.Pos.App.VentanaCaja"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="480" SizeToContent="Height" MaxHeight="720"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Icon="Assets/logo1-inv-compact-128.png"
        Style="{StaticResource PosWindow}">

    <StackPanel Margin="24">
        <TextBlock x:Name="TextoTitulo" FontSize="17" FontWeight="SemiBold" />
        <TextBlock x:Name="TextoSubtitulo" Style="{StaticResource MutedText}" Margin="0,4,0,16"
                   TextWrapping="Wrap" />

        <ScrollViewer MaxHeight="470" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- APERTURA -->
                <StackPanel x:Name="PanelApertura">
                    <TextBlock Text="Fondo de caja inicial" Style="{StaticResource SectionTitle}" />
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Bolívares (Bs)" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
                            <TextBox x:Name="AperturaBs" Padding="10,8" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,8,0">
                            <TextBlock Text="Dólares (USD)" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
                            <TextBox x:Name="AperturaUsd" Padding="10,8" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Pesos (COP)" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
                            <TextBox x:Name="AperturaPesos" Padding="10,8" />
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <!-- CIERRE -->
                <StackPanel x:Name="PanelCierre" Visibility="Collapsed">
                    <TextBlock Text="Dinero contado" Style="{StaticResource SectionTitle}" />
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Bolívares" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
                            <TextBox x:Name="CierreBs" Padding="10,8" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,8,0">
                            <TextBlock Text="Dólares" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
                            <TextBox x:Name="CierreUsd" Padding="10,8" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Pesos" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
                            <TextBox x:Name="CierrePesos" Padding="10,8" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Pagos digitales" Style="{StaticResource SectionTitle}" Margin="0,16,0,0" />
                    <Grid Margin="0,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,8">
                            <TextBlock Text="Punto de venta" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
                            <TextBox x:Name="CierrePunto" Padding="10,8" />
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,8">
                            <TextBlock Text="BioPago" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
                            <TextBox x:Name="CierreBioPago" Padding="10,8" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Pago móvil" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
                            <TextBox x:Name="CierrePagoMovil" Padding="10,8" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1">
                            <TextBlock Text="Transferencia" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
                            <TextBox x:Name="CierreTransferencia" Padding="10,8" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Fondo de caja" Style="{StaticResource SectionTitle}" Margin="0,16,0,0" />
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Bs" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
                            <TextBox x:Name="CierreFondoBs" Padding="10,8" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,8,0">
                            <TextBlock Text="USD" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
                            <TextBox x:Name="CierreFondoUsd" Padding="10,8" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Pesos" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
                            <TextBox x:Name="CierreFondoPesos" Padding="10,8" />
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <TextBlock Text="Observaciones" Style="{StaticResource MutedText}" Margin="0,16,0,4" />
                <TextBox x:Name="CampoObservaciones" Padding="10,8" Height="64"
                         AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
            </StackPanel>
        </ScrollViewer>

        <TextBlock x:Name="TextoError" Foreground="{StaticResource DangerBrush}" Margin="0,10,0,0"
                   TextWrapping="Wrap" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancelar" Style="{StaticResource SecondaryButton}" Padding="16,9"
                    Click="Cancelar_Click" />
            <Button x:Name="BotonConfirmar" Content="CONFIRMAR" Style="{StaticResource PrimaryButton}"
                    Padding="16,9" Margin="10,0,0,0" Click="Confirmar_Click" />
        </StackPanel>
    </StackPanel>
</Window>

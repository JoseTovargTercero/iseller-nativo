<Window x:Class="Iseller.Pos.App.VentanaUltimasVentas"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Últimas ventas" Width="1020" Height="520"
        MinWidth="760" MinHeight="380"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        Icon="Assets/logo1-inv-compact-128.png"
        Style="{StaticResource PosWindow}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Colores por moneda, iguales al POS web, y valores centrados en su columna. -->
        <Style x:Key="CeldaCop" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource InfoBrush}" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>
        <Style x:Key="CeldaBs" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>
        <Style x:Key="CeldaUsd" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MintBrush}" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>
        <Style x:Key="CeldaCentrada" TargetType="{x:Type DataGridCell}"
               BasedOn="{StaticResource {x:Type DataGridCell}}">
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="38" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="34" />
        </Grid.RowDefinitions>

        <!-- Barra superior -->
        <Border Grid.Row="0" Background="{StaticResource BgBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="Barra_MouseLeftButtonDown">
            <Grid Margin="16,0,8,0">
                <TextBlock Text="Últimas ventas" Style="{StaticResource MutedText}"
                           VerticalAlignment="Center" />
                <Button x:Name="BtnCerrar" Style="{StaticResource WindowCloseButton}"
                        HorizontalAlignment="Right" ToolTip="Cerrar (Esc)" Click="Cerrar_Click">
                    <Path Data="M0,0 L11,11 M11,0 L0,11" Stroke="White" StrokeThickness="1.2" />
                </Button>
            </Grid>
        </Border>

        <TextBlock Grid.Row="1" Margin="20,14,20,10" TextWrapping="Wrap"
                   Style="{StaticResource MutedText}"
                   Text="Tus últimas 5 ventas. Deshacer devuelve los productos al stock; si la venta ya se envió, también se anula en el servidor." />

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0" Margin="20,0,20,12">
            <Grid>
                <DataGrid x:Name="TablaVentas" AutoGenerateColumns="False" IsReadOnly="True"
                          BorderThickness="0" Background="Transparent" RowHeight="44">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="FECHA" Binding="{Binding Fecha}" Width="120"
                                            CellStyle="{StaticResource CeldaCentrada}" />
                        <DataGridTextColumn Header="TIPO" Binding="{Binding Tipo}" Width="110"
                                            CellStyle="{StaticResource CeldaCentrada}" />
                        <DataGridTextColumn Header="MÉTODO" Binding="{Binding Metodo}" Width="140"
                                            CellStyle="{StaticResource CeldaCentrada}" />
                        <DataGridTextColumn Header="PESOS" Binding="{Binding Pesos}" Width="140"
                                            CellStyle="{StaticResource CeldaCentrada}"
                                            ElementStyle="{StaticResource CeldaCop}" />
                        <DataGridTextColumn Header="BOLÍVARES" Binding="{Binding Bolivares}" Width="150"
                                            CellStyle="{StaticResource CeldaCentrada}"
                                            ElementStyle="{StaticResource CeldaBs}" />
                        <DataGridTextColumn Header="DÓLARES" Binding="{Binding Dolares}" Width="120"
                                            CellStyle="{StaticResource CeldaCentrada}"
                                            ElementStyle="{StaticResource CeldaUsd}" />
                        <DataGridTextColumn Header="ESTADO" Binding="{Binding Estado}" Width="*"
                                            CellStyle="{StaticResource CeldaCentrada}" />
                        <DataGridTemplateColumn Header="" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="DESHACER" Style="{StaticResource MiniOutlineDanger}"
                                            VerticalAlignment="Center" Click="Deshacer_Click" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel x:Name="MensajeVacio" VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="Collapsed">
                    <TextBlock Text="No hay ventas para mostrar" FontSize="16" FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Cuando vendas aparecerán aquí, listas para deshacer."
                               Style="{StaticResource MutedText}" Margin="0,8,0,0"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="3" Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <TextBlock x:Name="TextoEstado" Style="{StaticResource MutedText}" Margin="20,0"
                       VerticalAlignment="Center" TextWrapping="Wrap" />
        </Border>
    </Grid>
</Window>

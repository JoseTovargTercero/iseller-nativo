<Window x:Class="Iseller.Pos.App.VentanaCambio"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Calcular cambio" Width="420" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Icon="Assets/logo1-inv-compact-128.png"
        Style="{StaticResource PosWindow}">

    <StackPanel Margin="24">
        <TextBlock Text="Cantidad recibida" Style="{StaticResource SectionTitle}" />
        <TextBlock Text="Escribe el monto que entrega el cliente." Style="{StaticResource MutedText}"
                   Margin="0,2,0,10" />
        <TextBox x:Name="CampoRecibido" Padding="12,10" FontSize="18"
                 TextChanged="CampoRecibido_TextChanged" />

        <Border Style="{StaticResource Card}" Margin="0,18,0,0">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Text="Pesos:" Width="110" Style="{StaticResource MutedText}" />
                    <TextBlock x:Name="TextoPesos" Foreground="{StaticResource InfoBrush}"
                               FontWeight="Bold" FontSize="16" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Text="Dólares:" Width="110" Style="{StaticResource MutedText}" />
                    <TextBlock x:Name="TextoDolares" Foreground="{StaticResource MintBrush}"
                               FontWeight="Bold" FontSize="16" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Text="Bolívares:" Width="110" Style="{StaticResource MutedText}" />
                    <TextBlock x:Name="TextoBolivares" Foreground="{StaticResource DangerBrush}"
                               FontWeight="Bold" FontSize="16" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Button Content="CERRAR" Style="{StaticResource PrimaryButton}" Padding="16,9"
                HorizontalAlignment="Right" Margin="0,20,0,0" Click="Cerrar_Click" />
    </StackPanel>
</Window>

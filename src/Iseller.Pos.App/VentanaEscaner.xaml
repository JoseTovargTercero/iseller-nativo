<Window x:Class="Iseller.Pos.App.VentanaEscaner"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:Iseller.Pos.App"
        Title="Producto escaneado" Width="440" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        WindowStyle="None" Focusable="True"
        Icon="Assets/logo1-inv-compact-128.png"
        Style="{StaticResource PosWindow}"
        PreviewKeyDown="Ventana_PreviewKeyDown"
        PreviewMouseMove="Ventana_PreviewMouseMove"
        PreviewMouseDown="Ventana_PreviewMouseDown">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border BorderBrush="#80A8B4C2" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="4" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Barra de tiempo: al vaciarse se agrega solo al carrito. -->
            <Grid x:Name="PistaBarra" Grid.Row="0" Background="{StaticResource BorderBrush}">
                <Rectangle x:Name="BarraTiempo" Fill="{StaticResource MintBrush}"
                           HorizontalAlignment="Left" />
            </Grid>

            <!-- Barra superior -->
            <Border Grid.Row="1" Background="{StaticResource BgBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="Barra_MouseLeftButtonDown">
                <Grid Margin="16,0,8,0" Height="34">
                    <TextBlock Text="Producto escaneado" Style="{StaticResource MutedText}"
                               VerticalAlignment="Center" />
                    <Button x:Name="BtnCerrar" Style="{StaticResource WindowCloseButton}"
                            HorizontalAlignment="Right" ToolTip="Cerrar (Esc)" Click="Cerrar_Click">
                        <Path Data="M0,0 L11,11 M11,0 L0,11" Stroke="White" StrokeThickness="1.2" />
                    </Button>
                </Grid>
            </Border>

            <StackPanel Grid.Row="2" Margin="20,18,20,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Width="104" Height="104" CornerRadius="8" Background="#0AFFFFFF"
                            ClipToBounds="True" VerticalAlignment="Top">
                        <Grid>
                            <Path Data="M4,10 L9,14 L13,9 L17,14 M4,6 A1.2,1.2 0 1 0 4,6.01 M3,3 L19,3 L19,19 L3,19 Z"
                                  Stroke="#4D8892A0" StrokeThickness="1.3" Stretch="Uniform" Margin="26" />
                            <Image Source="{Binding Imagen}" Stretch="UniformToFill" />
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Nombre}" FontSize="16" FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding StockTexto}" Style="{StaticResource MutedText}"
                                   Margin="0,6,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="{Binding PrecioDolar}" FontSize="17" FontWeight="Bold"
                                       Foreground="{StaticResource MintBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding PrecioBs}" FontSize="17" FontWeight="Bold"
                                       Foreground="{StaticResource DangerBrush}" Margin="14,0,0,0"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding PrecioPeso}" FontSize="17" FontWeight="Bold"
                                       Foreground="{StaticResource InfoBrush}" Margin="14,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Cantidad" Style="{StaticResource MutedText}" Margin="0,18,0,6" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Style="{StaticResource SecondaryButton}" Width="44" Height="42" Padding="0"
                            FontSize="20" Content="&#x2212;" VerticalAlignment="Center"
                            ToolTip="Menos (flecha abajo o tecla −)" AutomationProperties.Name="Menos"
                            Click="Cantidad_Menos" />
                    <TextBox x:Name="CampoCantidad" Width="110" Margin="10,0" Padding="8,10" FontSize="19"
                             HorizontalContentAlignment="Center" VerticalAlignment="Center"
                             Text="{Binding CantidadTexto, UpdateSourceTrigger=PropertyChanged}"
                             app:Numerico.Decimales="True" />
                    <Button Style="{StaticResource SecondaryButton}" Width="44" Height="42" Padding="0"
                            FontSize="20" Content="+" VerticalAlignment="Center"
                            ToolTip="Más (flecha arriba o tecla +)" AutomationProperties.Name="Mas"
                            Click="Cantidad_Mas" />
                </StackPanel>

                <Button x:Name="BotonAgregar" Style="{StaticResource PrimaryButton}" Height="44"
                        Margin="0,18,0,0" Content="AGREGAR AL CARRITO" Click="Agregar_Click" />

                <TextBlock x:Name="TextoAyuda" Style="{StaticResource MutedText}"
                           HorizontalAlignment="Center" Margin="0,10,0,0" TextAlignment="Center"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
